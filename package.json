{
  "name": "@zx06/tavily",
  "version": "0.3.0",
  "description": "Tavily web search for DeepSeek Harness: a ctx.web search provider plus tavily_search/extract/crawl/map/research tools, with a settings page for the API key, quota, and audit log",
  "license": "MIT",
  "type": "module",
  "main": "./dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "tavily",
    "search",
    "web-search"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p packages/plugin-kit/tsconfig.json && tsc -p tsconfig.json --emitDeclarationOnly && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "node --check dist/host.js && node --check client.js",
    "test": "tsx --test \"test/**/*.test.ts\" \"packages/plugin-kit/test/**/*.test.ts\"",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@tavily/core": "^0.7.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-web": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@dsh-plugins/plugin-kit": "workspace:*",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zx06/dsh-tavily.git"
  },
  "homepage": "https://github.com/zx06/dsh-tavily#readme",
  "bugs": {
    "url": "https://github.com/zx06/dsh-tavily/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.6"
}
